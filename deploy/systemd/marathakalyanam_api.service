[Unit]
Description=marathakalyanam Litestar API (port 8003)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
WorkingDirectory=/opt/marathakalyanam/backend
User=www-data
Group=www-data
EnvironmentFile=/opt/marathakalyanam/.env
ExecStart=/bin/bash -c 'source /opt/marathakalyanam/backend/.venv/bin/activate && \
  uvicorn app.main:app \
    --host 127.0.0.1 \
    --port 8003 \
    --workers 1 \
    --log-level info \
    --proxy-headers \
    --forwarded-allow-ips=127.0.0.1 \
    2>&1 | tee -a /opt/marathakalyanam/.log/api.log'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
